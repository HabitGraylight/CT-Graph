  "deterministic_mechanisms": [
    {
      "output": "total_volume_ml",
      "expression_documentation": "other_liquid_ml + syrup_dose_ml + additional_water_ml",
      "assumption": "近似体积可加；无过滤、蒸发、固体溶解或继续融冰。"
    },
    {
      "output": "sugar_mass_g",
      "expression_documentation": "other_sugar_g + syrup_dose_ml * syrup_sugar_g_l / 1000",
      "assumption": "糖浆浓度与剂量为同一批次的明确值，无糖损失。"
    },
    {
      "output": "sugar_g_l",
      "expression_documentation": "sugar_mass_g * 1000 / total_volume_ml",
      "assumption": "total_volume_ml > 0"
    },
    {
      "output": "acid_g_l",
      "expression_documentation": "acid_equivalent_g * 1000 / total_volume_ml",
      "assumption": "原味糖浆与补充水不贡献可滴定酸度，统一柠檬酸当量口径；不代表 pH。"
    },
    {
      "output": "abv",
      "expression_documentation": "ethanol_ml * 100 / total_volume_ml",
      "assumption": "原味糖浆和补充水无乙醇；忽略混合体积收缩。"
    }
  ],
