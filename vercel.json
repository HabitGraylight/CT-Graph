{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "python scripts/build_cloud.py",
  "outputDirectory": "cloud-dist",
  "functions": {
    "api/app.py": {
      "maxDuration": 60,
      "excludeFiles": "{data/**,output/**,tmp/**,.agents/**,.git/**,tests/**,web/**,docs/**,cloud/web/**,cloud-dist/**}"
    }
  },
  "headers": [{
    "source": "/(.*)",
    "headers": [
      {"key":"X-Content-Type-Options","value":"nosniff"},
      {"key":"Referrer-Policy","value":"no-referrer"},
      {"key":"Permissions-Policy","value":"camera=(), microphone=(), geolocation=()"},
      {"key":"Content-Security-Policy","value":"default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"}
    ]
  }]
}
